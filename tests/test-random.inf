Constant DEBUG;
Constant OPTIONAL_EXTENDED_METAVERBS;
Constant INITIAL_LOCATION_VALUE = TheRoom;



Constant Story "NumberTokenDescribeGrammarTest";
Include "globals.h";
Include "puny.h";

[ Initialise; ];

Object TheRoom "The Room" with description "This is a room", each_turn [; print "random ", random(100), "^"; ] has light;

[ FooSub; "Got here: ", noun; ];
Verb 'foo' * 'for' number 'unit' -> Foo;

[ BlobSub; "You blob: ", second; ];
Verb 'blob' * noun 'to' number 'minute' -> Blob;

